# ============================================
# 퐁당 PongDang — Environment Variables
# ============================================
# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# cp .env.example .env

# === Database (PostgreSQL) ===
POSTGRES_DB=pongdang
POSTGRES_USER=pongdang
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://pongdang:YOUR_PASSWORD@db:5432/pongdang

# === Django ===
SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=localhost,127.0.0.1
# 같은 출처 운영은 비워 둡니다. 프런트와 API를 분리할 때만 경로 없는
# 정확한 HTTPS origin을 쉼표로 지정하세요(예: https://app.example.com).
CORS_ALLOWED_ORIGINS=
# 운영 Compose는 HTTPS 종단 프록시를 전제로 합니다. 로컬 개발은
# docker-compose.dev.yml 또는 config.settings.dev를 사용하세요.
SECURE_SSL_REDIRECT=True

# 운영 Nginx는 기본적으로 호스트 loopback에만 바인딩합니다. Caddy,
# Cloudflare Tunnel 등 신뢰 가능한 HTTPS 종단 프록시가 이 주소로 전달해야 합니다.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080

# === Observation pipeline cadence (seconds) ===
# Public API quotas and provider issue cycles must be reviewed before lowering.
WEATHER_SYNC_INTERVAL_SECONDS=1800
MARINE_SYNC_INTERVAL_SECONDS=3600
WATER_INDEX_INTERVAL_SECONDS=300

# === 공공데이터포털 (data.go.kr) ===
# https://www.data.go.kr 에서 회원가입 후 각 API별 활용신청
# 아래 키는 Django 서버 전용입니다. VITE_ 접두사를 붙이거나 브라우저 코드에서 읽지 마세요.
# 인코딩된 serviceKey를 입력하세요.
DATA_GO_KR_SERVICE_KEY=

# 한국관광공사 TourAPI 4.0
TOUR_API_KEY=

# 기상청 단기예보/중기예보/생활기상지수
KMA_API_KEY=

# 국립해양조사원 (KHOA)
KHOA_API_KEY=

# 환경부 수질정보
MOE_API_KEY=

# === Frontend public runtime/build settings ===
# 같은 도메인 배포에서는 Nginx가 /api/를 Django로 프록시합니다.
VITE_API_BASE_URL=/api/v1/

# 카카오맵 JavaScript 키는 브라우저에 공개되는 클라이언트 식별자입니다.
# https://developers.kakao.com 에서 허용 도메인을 반드시 제한하세요.
VITE_KAKAO_MAP_KEY=

# 서버측 카카오 Local/길찾기 API를 추가할 때만 별도 REST 키를 사용하세요.
# JavaScript 키를 서버 키로 재사용하지 않습니다.
KAKAO_MAP_API_KEY=

# 네이버맵: https://developers.naver.com
# NAVER_MAP_CLIENT_ID=
# NAVER_MAP_CLIENT_SECRET=

# === Redis (Phase 3: Celery) ===
# CELERY_BROKER_URL=redis://redis:6379/0
# CACHE_REDIS_URL=redis://redis:6379/1
