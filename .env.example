# ============================================
# 퐁당 PongDang — Environment Variables
# ============================================
# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# cp .env.example .env

# === Database (PostgreSQL) ===
POSTGRES_DB=pongdang
POSTGRES_USER=pongdang
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://pongdang:change-me-in-production@db:5432/pongdang

# === Django ===
SECRET_KEY=django-insecure-change-this-to-a-random-50-char-string
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=True
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === 공공데이터포털 (data.go.kr) ===
# https://www.data.go.kr 에서 회원가입 후 각 API별 활용신청
# 인코딩된 serviceKey를 입력하세요
DATA_GO_KR_SERVICE_KEY=

# 한국관광공사 TourAPI 4.0
TOUR_API_KEY=

# 기상청 단기예보/중기예보/생활기상지수
KMA_API_KEY=

# 국립해양조사원 (KHOA) — 조위·수온은 같은 키. 해수욕/이안류/파랑/서핑/갯벌 지수는
# data.go.kr에서 해당 OpenAPI마다 활용신청(개발계정 자동승인, 무료)해야 합니다.
# 구 바다누리 oceangrid OpenAPI는 2026-04-01 종료되었습니다.
KHOA_API_KEY=

# 키를 넣은 뒤 컨디션 갱신:
# cd backend && python manage.py refresh_conditions
# python manage.py fetch_weather --spot-id=1 --dry-run
# python manage.py fetch_quality --spot-id=1 --dry-run
# python manage.py refresh_conditions --skip-tour --loop --interval 10800

# Docker refresher interval (seconds). Default 3 hours.
# REFRESH_INTERVAL_SECONDS=10800

# 환경부 수질정보
MOE_API_KEY=

# === Map API (Phase 5) ===
# 카카오맵 JavaScript 키 (Vite). https://developers.kakao.com
# 앱 키 → JavaScript 키. 플랫폼에 http://localhost:5173 사이트 도메인을 등록하세요.
# 카카오맵 사용 설정(앱 설정 → 카카오맵)도 켜야 합니다.
VITE_KAKAO_MAP_KEY=
# 루트 .env 별칭. Vite는 VITE_KAKAO_MAP_KEY를 우선합니다.
KAKAO_MAP_API_KEY=

# 네이버맵: https://developers.naver.com
# NAVER_MAP_CLIENT_ID=
# NAVER_MAP_CLIENT_SECRET=

# === Redis (Phase 3: Celery) ===
# CELERY_BROKER_URL=redis://redis:6379/0
# CACHE_REDIS_URL=redis://redis:6379/1
